{
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "welovepdf.best"
        }
      ],
      "destination": "https://www.welovepdf.best/:path*",
      "permanent": true
    }
  ]
}
