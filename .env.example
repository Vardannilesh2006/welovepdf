# ==============================================================================
# WeLovePDF Environment Variables Configuration Example
# Copy this file to .env or .env.local before starting containers.
# ==============================================================================

# [SECRET] Server-side Google Gemini API Key for AI PDF processing (OCR, Translation, Summarization)
GEMINI_API_KEY=your_gemini_api_key_here

# [PUBLIC] Runtime Port (Default: 3000 inside container)
PORT=3000

# [PUBLIC] Environment Mode (production / development)
NODE_ENV=production

# [PUBLIC] Optional Google Analytics & GTM Tracking IDs
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# [PUBLIC] Blogger Blog URL for In-Site Knowledge Hub & Feed Integration
BLOGGER_BLOG_URL=https://sarkaripixels.blogspot.com

